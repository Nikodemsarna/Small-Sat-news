# ---------------------------------------------------------------------------
# Small-Sat News — configuration
# Copy to `.env` for local runs, or set these as GitHub Actions secrets.
# ---------------------------------------------------------------------------

# --- Summarization (pick a provider) ----------------------------------------
# Set ONE API key below. The provider is auto-detected from whichever key is
# present (free providers first), or force it with SMALLSAT_PROVIDER.
# Without any key, the newsletter falls back to extractive feed descriptions.
#
# Option A — Google Gemini (FREE, recommended). Get a key (no credit card) at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Option B — Groq (FREE, fast Llama models). Key at https://console.groq.com/keys
GROQ_API_KEY=
#
# Option C — Anthropic / Claude (paid; needs `pip install anthropic`).
ANTHROPIC_API_KEY=

# Optional. Force a provider (gemini | groq | anthropic) and/or model.
SMALLSAT_PROVIDER=
SMALLSAT_MODEL=                 # blank = provider default (gemini-2.0-flash, etc.)
SMALLSAT_EFFORT=medium          # Anthropic only: low | medium | high | max

# --- Delivery ---------------------------------------------------------------
# Where the newsletter is sent.
NEWSLETTER_TO=nikodem.sarna@gmail.com

# Pick ONE delivery provider by setting its variables.
#
# Option A — Resend (recommended, simplest). Free tier sends from
# onboarding@resend.dev to any address; verify a domain to use your own From.
RESEND_API_KEY=
NEWSLETTER_FROM=Small-Sat News <onboarding@resend.dev>
#
# Option B — SMTP (e.g. Gmail with an App Password).
# If RESEND_API_KEY is unset but SMTP_HOST is set, SMTP is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP From defaults to SMTP_USER if NEWSLETTER_FROM is not set.

# --- Behavior ---------------------------------------------------------------
# How far back to look for "recent" news, in hours.
SMALLSAT_WINDOW_HOURS=30
# Hard cap on how many stories to include after filtering.
SMALLSAT_MAX_ARTICLES=25
# If no matching stories are found, skip sending instead of mailing an empty
# edition (set to 0 to always send).
SMALLSAT_SKIP_IF_EMPTY=1
